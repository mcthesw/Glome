---
const zh = Astro.locals.starlightRoute.lang === 'zh-CN';
---
<footer class="site-footer">
  <span>{zh ? 'Glome — 面向 Godot 的三维球面几何插件' : 'Glome — S³ geometry plugin for Godot'}</span>
  <a href="https://github.com/mcthesw/Glome">GitHub</a>
</footer>
<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 3rem;
    padding-block: 1.25rem 0.5rem;
    border-top: 1px solid var(--gl-border);
    color: var(--gl-text-muted);
    font-size: var(--gl-fs-sm);
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--gl-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
