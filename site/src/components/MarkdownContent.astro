---
import MarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
---
<MarkdownContent><slot /></MarkdownContent>

<script>
  // Make wide content keyboard-scrollable only while it actually overflows.
  const blocks = document.querySelectorAll<HTMLElement>(
    '.sl-markdown-content :is(table, pre, .katex-display):not([tabindex])',
  );
  function sync(element: HTMLElement) {
    if (element.scrollWidth > element.clientWidth + 1) element.tabIndex = 0;
    else element.removeAttribute('tabindex');
  }
  const observer = new ResizeObserver(entries => {
    for (const { target } of entries) sync(target as HTMLElement);
  });
  for (const block of blocks) observer.observe(block);
  document.fonts.ready.then(() => blocks.forEach(sync));
</script>
