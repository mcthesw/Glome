---
import '../../styles/instruments.css';
interface Props { lang?: 'en' | 'zh-CN' }
const zh = Astro.props.lang === 'zh-CN';
const markerId = zh ? 'gl-arrow-zh' : 'gl-arrow-en';
const markerAccentId = zh ? 'gl-arrow-acc-zh' : 'gl-arrow-acc-en';
---
<figure class="gl-figure flow-figure not-content">
  {/* Desktop horizontal branching diagram */}
  <svg
    class="flow-svg flow-desktop"
    viewBox="0 0 640 156"
    role="img"
    aria-label={zh
      ? '数据流：Godot 场景经 GlomeBaker 与 GlomeBuffers 烘焙后分为两路，GPU 支路经 Vulkan 计算着色器输出到 Texture2DRD 与 TextureRect，CPU 支路供碰撞与拾取使用。'
      : 'Data flow: Godot Scene bakes through GlomeBaker and GlomeBuffers, then branches to Vulkan Compute, Texture2DRD, and TextureRect on the GPU and to Collision and Picking on the CPU.'}
  >
    <defs>
      <marker id={markerId} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M1 1.5 L7 4 L1 6.5" fill="none" stroke="var(--gl-text-muted)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
      <marker id={markerAccentId} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M1 1.5 L7 4 L1 6.5" fill="none" stroke="var(--gl-accent)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    {/* Nodes */}
    <rect x="4" y="48" width="128" height="58" rx="5" fill="var(--gl-bg)" />
    <text x="68" y="72" text-anchor="middle" class="node-title">{zh ? 'Godot 场景' : 'Godot Scene'}</text>
    <text x="68" y="92" text-anchor="middle" class="node-sub">{zh ? '网格、灯光、碰撞' : 'Mesh, light, shape'}</text>

    <rect x="152" y="48" width="136" height="58" rx="5" fill="var(--gl-bg)" />
    <text x="220" y="72" text-anchor="middle" class="node-title">GlomeBaker</text>
    <text x="220" y="92" text-anchor="middle" class="node-sub">{zh ? 'S³ 快照与 SSBO' : 'S³ snapshot, SSBOs'}</text>

    <rect x="334" y="10" width="138" height="54" rx="5" fill="var(--gl-bg)" />
    <text x="403" y="33" text-anchor="middle" class="node-title">{zh ? 'Vulkan 计算' : 'Vulkan Compute'}</text>
    <text x="403" y="51" text-anchor="middle" class="node-sub">{zh ? '内置或自定义' : 'Built-in or custom'}</text>

    <rect x="498" y="10" width="138" height="54" rx="5" fill="var(--gl-bg)" />
    <text x="567" y="33" text-anchor="middle" class="node-title">Texture2DRD</text>
    <text x="567" y="51" text-anchor="middle" class="node-sub">{zh ? '显示与 .gdshader' : 'Display, .gdshader'}</text>

    <rect x="334" y="92" width="212" height="54" rx="5" fill="var(--gl-bg)" />
    <text x="440" y="115" text-anchor="middle" class="node-title">{zh ? 'CPU 碰撞与拾取' : 'CPU Collision & Picking'}</text>
    <text x="440" y="133" text-anchor="middle" class="node-sub">{zh ? '角色控制器、编辑器视口' : 'Character controller, editor'}</text>

    {/* Connectors */}
    <line x1="132" y1="77" x2="149" y2="77" stroke="var(--gl-text-muted)" stroke-width="1.4" marker-end={`url(#${markerId})`} />
    <path d="M 288 77 L 306 77 L 306 37 L 331 37" fill="none" stroke="var(--gl-accent)" stroke-width="1.5" marker-end={`url(#${markerAccentId})`} />
    <line x1="472" y1="37" x2="495" y2="37" stroke="var(--gl-accent)" stroke-width="1.5" marker-end={`url(#${markerAccentId})`} />
    <path d="M 288 77 L 306 77 L 306 119 L 331 119" fill="none" stroke="var(--gl-text-muted)" stroke-width="1.4" marker-end={`url(#${markerId})`} />

    {/* Branch lane labels */}
    <text x="312" y="29" class="lane-gpu">GPU</text>
    <text x="312" y="137" class="lane-cpu">CPU</text>
  </svg>

  {/* Mobile vertical branching diagram */}
  <svg
    class="flow-svg flow-mobile"
    viewBox="0 0 320 280"
    role="img"
    aria-label={zh
      ? '数据流：Godot 场景经 GlomeBaker 烘焙后分为 GPU 计算渲染与 CPU 碰撞拾取两路。'
      : 'Data flow: Godot Scene bakes through GlomeBaker, then branches to GPU compute rendering and CPU collision and picking.'}
  >
    <defs>
      <marker id={markerId + '-m'} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M1 1.5 L7 4 L1 6.5" fill="none" stroke="var(--gl-text-muted)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
      <marker id={markerAccentId + '-m'} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M1 1.5 L7 4 L1 6.5" fill="none" stroke="var(--gl-accent)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <rect x="44" y="4" width="232" height="48" rx="5" fill="var(--gl-bg)" />
    <text x="160" y="25" text-anchor="middle" class="node-title">{zh ? 'Godot 场景' : 'Godot Scene'}</text>
    <text x="160" y="42" text-anchor="middle" class="node-sub">{zh ? '网格、灯光、碰撞体' : 'Meshes, lights, colliders'}</text>

    <rect x="44" y="74" width="232" height="48" rx="5" fill="var(--gl-bg)" />
    <text x="160" y="95" text-anchor="middle" class="node-title">GlomeBaker & GlomeBuffers</text>
    <text x="160" y="112" text-anchor="middle" class="node-sub">{zh ? 'S³ 快照与只读 SSBO' : 'S³ snapshot & SSBOs'}</text>

    <rect x="6" y="156" width="146" height="48" rx="5" fill="var(--gl-bg)" />
    <text x="79" y="177" text-anchor="middle" class="node-title">{zh ? 'Vulkan 计算' : 'Vulkan Compute'}</text>
    <text x="79" y="194" text-anchor="middle" class="node-sub">{zh ? '内置或自定义' : 'Built-in / custom'}</text>

    <rect x="6" y="226" width="146" height="48" rx="5" fill="var(--gl-bg)" />
    <text x="79" y="247" text-anchor="middle" class="node-title">Texture2DRD</text>
    <text x="79" y="264" text-anchor="middle" class="node-sub">{zh ? '显示与 .gdshader' : 'Display, .gdshader'}</text>

    <rect x="168" y="156" width="146" height="58" rx="5" fill="var(--gl-bg)" />
    <text x="241" y="180" text-anchor="middle" class="node-title">{zh ? 'CPU 碰撞拾取' : 'CPU Queries'}</text>
    <text x="241" y="199" text-anchor="middle" class="node-sub">{zh ? '角色控制器、编辑器' : 'Collision & picking'}</text>

    <line x1="160" y1="52" x2="160" y2="71" stroke="var(--gl-text-muted)" stroke-width="1.4" marker-end={`url(#${markerId}-m)`} />
    <path d="M 160 122 L 160 138 L 79 138 L 79 153" fill="none" stroke="var(--gl-accent)" stroke-width="1.5" marker-end={`url(#${markerAccentId}-m)`} />
    <line x1="79" y1="204" x2="79" y2="223" stroke="var(--gl-accent)" stroke-width="1.5" marker-end={`url(#${markerAccentId}-m)`} />
    <path d="M 160 122 L 160 138 L 241 138 L 241 153" fill="none" stroke="var(--gl-text-muted)" stroke-width="1.4" marker-end={`url(#${markerId}-m)`} />

    <text x="114" y="133" text-anchor="middle" class="lane-gpu">GPU</text>
    <text x="206" y="133" text-anchor="middle" class="lane-cpu">CPU</text>
  </svg>
</figure>

<style>
  .flow-figure {
    padding: 1rem;
  }
  .flow-svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .flow-mobile {
    display: none;
  }
  .node-title {
    font-family: var(--sl-font);
    font-size: 13px;
    font-weight: 600;
    fill: var(--gl-text);
  }
  .node-sub {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    fill: var(--gl-text-muted);
  }
  .lane-gpu {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    fill: var(--gl-accent);
  }
  .lane-cpu {
    font-family: var(--sl-font-mono);
    font-size: 11px;
    fill: var(--gl-text-muted);
  }
  @media (max-width: 38rem) {
    .flow-desktop { display: none; }
    .flow-mobile { display: block; }
  }
</style>
